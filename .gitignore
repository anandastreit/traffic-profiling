# Python artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Environments
.env
.secrets.env
**/.secrets.env
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# Data files
*.csv
*.parquet
*.feather
*.pkl
*.mat
*.rds
*.sav
*.h5
*.hdf5
*.npy
*.npy
*.joblib

# Figures / reports — ignore everywhere except python/figures/
*.png
*.jpg
*.jpeg
*.svg
*.gif
*.pdf
!python/figures/*.png

# Logs / temp / R history
*.log
*.tmp
*.save
.Rhistory
output_down.txt
output_up.txt
# Log CSVs / reports may contain internal aggregate data — ignore
**/logs/*.csv
**/logs/*.log
**/logs/*.html

# Tool caches
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.tox/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# python/data — keep directory structure via .gitkeep, ignore all data files
python/data/raw/**/*
python/data/daily/**/*
python/data/output/**/*
python/data/output_tol1e6/**/*
python/data/output_tol1e8/**/*
python/data/input_wan/**/*
python/data/output_wan/**/*
!python/data/raw/wan_metrics/README.md
!**/.gitkeep

# matlab/data — large exported files (loadings_all.csv ~418MB, already covered by *.csv)
matlab/data/

# Old MATLAB/Python research dirs — local reference only, never committed
/SUESTE/
/SUESTE_OLD/
